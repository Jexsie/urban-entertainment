# EUDIPLO backend (no trailing slash)
EUDIPLO_URL=https://eudiplo.playground.open-elements.cloud
# Least-privilege gateway client of the urban-entertainment tenant:
# only presentation:request, allowedPresentationConfigs = [age-over-18]
EUDIPLO_CLIENT_ID=urban-entertainment-gateway
EUDIPLO_CLIENT_SECRET=
PRESENTATION_CONFIG_ID=age-over-18
# Public URL of this site. With an https:// URL the same-device wallet
# redirect is enabled; with localhost only the QR code (cross-device) is used.
APP_URL=http://localhost:3001
# Signs the age pass cookie: openssl rand -hex 32
APP_SECRET=
